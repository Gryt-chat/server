# Gryt Self-Hosted Server Configuration
# Edit this file, then run start.bat to launch all services.

# ── Server ─────────────────────────────────────────────────────────
SERVER_NAME=My Gryt Server
PORT=5000
# Listens on every network interface, so other devices on your LAN can
# reach it. Set to 127.0.0.1 if only this machine should ever connect.
HOST=0.0.0.0

# ── Database (SQLite, stored in DATA_DIR) ──────────────────────────
DATA_DIR=./data

# ── Storage (filesystem is the default for self-hosted) ────────────
STORAGE_BACKEND=filesystem
# S3_BUCKET is used as the subdirectory name inside DATA_DIR
S3_BUCKET=uploads

# ── Identity ─────────────────────────────────────────────────────
# Uses the default Gryt identity service (id.gryt.chat) for certificate verification.
# EXTERNAL_HOST should be set to the URL clients use to reach this server
# EXTERNAL_HOST=http://your-server-ip:5000

# ── SFU (voice/video) ─────────────────────────────────────────────
SFU_PORT=5005
SFU_WS_HOST=ws://127.0.0.1:5005
SFU_PUBLIC_HOST=127.0.0.1:5005
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Only this machine can register a server with this SFU or read its metrics. To reach them
# from another machine, set these to this machine's address, or empty to listen everywhere.
SFU_CONTROL_HOST=127.0.0.1
SFU_METRICS_HOST=127.0.0.1

# Turns the server's own metrics off. Their default port is 9091, the same as the SFU's,
# and they'd listen on every address.
METRICS_PORT=0

# ── Image Worker ──────────────────────────────────────────────────
# IMAGE_WORKER_CONCURRENCY=2
# IMAGE_WORKER_POLL_MS=1000

# ── Optional settings ─────────────────────────────────────────────
# CORS_ORIGIN=*
# JWT_SECRET=change-me-to-something-random
# REFRESH_TOKEN_TTL_DAYS=7
